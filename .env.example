# Gemini Vision API key — used for scene analysis and auto-detecting object labels.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here

# Optional: shared-secret header required by the editor's write endpoints
# (save/delete/upload/regenerate). Unset = no auth enforced (fine for local
# dev; set this before exposing a deployment's URL beyond trusted use). The
# editor prompts for it once and caches it in localStorage.
# ROOM3D_API_TOKEN=

# Optional: override the checkpoint path (default: checkpoints/vggt_omega_1b_512.pt)
# CHECKPOINT_PATH=/path/to/custom/checkpoint.pt

# Optional: override image resolution (default: 256 on CUDA/CPU, 128-256 on MPS)
# IMAGE_RESOLUTION=256
